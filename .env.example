# Immigration Copilot - Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/immigration-copilot?retryWrites=true&w=majority
MONGODB_DB_NAME=immigration-copilot

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=immigration-copilot-docs

# Application Settings
NODE_ENV=development
LOG_LEVEL=debug
CDP_PORT=9222

# Session Settings
SESSION_SECRET=your-super-secret-session-key-change-this
SESSION_EXPIRY_DAYS=7
